# ==============================================================================
# AdsMonster - Environment Variables Template
# Copy this file to .env.local for local development, or add these keys
# to your Vercel Project Settings -> Environment Variables for production.
# ==============================================================================

# ==============================================================================
# 1. Database Configuration (Turso Cloud libSQL / SQLite)
# ==============================================================================
# Turso provides a free cloud database compatible with libSQL / SQLite.
# Get free credentials at: https://turso.tech
# Run:
#   turso db create adsmonster
#   turso db show adsmonster --url
#   turso db tokens create adsmonster
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ==============================================================================
# 2. Authentication & Session Secrets
# ==============================================================================
# Generate a secure 64-character random string for production:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_64_character_hex_session_secret_here
JWT_SECRET=your_random_64_character_hex_jwt_secret_here

# Admin Account Initial Credentials
ADMIN_EMAIL=admin@adsmonster.com
ADMIN_PASSWORD=ChangeMe!2024Secure

# ==============================================================================
# 3. Public Website Application URL
# ==============================================================================
# Local: http://localhost:3000
# Vercel: https://your-project-name.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 4. Email Configuration (Nodemailer)
# ==============================================================================
# Destination inbox where new client inquiries from the contact form are delivered:
CONTACT_RECEIVER_EMAIL=hello@adsmonster.com

# SMTP Server Settings (Gmail, Hostinger, cPanel, Brevo, SendGrid, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="AdsMonster" <noreply@adsmonster.com>
SEND_CLIENT_CONFIRMATION=true

# ==============================================================================
# 5. Stripe Payments (Optional)
# ==============================================================================
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# 6. PayPal Payments (Optional)
# ==============================================================================
# https://developer.paypal.com/dashboard/
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=
